# ============================================================
# GODOT
# ============================================================

# Godot generated cache
.godot/

# Legacy Godot cache
.import/

# ============================================================
# HOPLITE - DOWNLOADED / GENERATED ASSETS
# ============================================================

# Raw downloaded files - recreated by SETUP_ASSETS.bat
_downloads/

# Runtime assets - recreated by SETUP_ASSETS.bat
assets/runtime/

# Mixamo is converted separately: keep the optimized runtime package, not the
# several-hundred-MB raw FBX sources or the converter's working copies.
!assets/runtime/
assets/runtime/*
!assets/runtime/mixamo/
!assets/runtime/mixamo/**
_source/mixamo_raw/
_source/mixamo_pipeline/input/
_source/mixamo_pipeline/output/

# Generated asset verification/report
ASSET_REPORT.txt

# ============================================================
# BUILD / EXPORT
# ============================================================

build/
builds/
dist/
export/
exports/

*.exe
*.pck
*.apk
*.aab

# ============================================================
# TEMP / LOGS
# ============================================================

*.log
*.tmp
*.temp
*.bak
*.old

# Local audit/probe workspaces created at the repository root
/.tmp_*

# Local Godot editor/runtime bundle (the project itself lives at the root)
/Godot/

# Python tooling caches
__pycache__/
*.py[cod]
.pytest_cache/

# Blender automatic backup files; keep the authored *.blend sources
*.blend1
*.blend2

# ============================================================
# WINDOWS
# ============================================================

Thumbs.db
Desktop.ini

# ============================================================
# IDE
# ============================================================

.vs/
.idea/

# Keep .vscode by default if project settings are useful.
# Uncomment if you want it local only:
# .vscode/

# ============================================================
# IMPORTANT GODOT FILES TO KEEP
# ============================================================

